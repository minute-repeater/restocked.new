{
  "name": "covet",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @covet/api dev",
    "dev:worker": "pnpm --filter @covet/worker dev",
    "dev:web": "pnpm --filter @covet/web dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @covet/api build",
    "build:worker": "pnpm --filter @covet/worker build",
    "build:web": "pnpm --filter @covet/web build",
    "db:generate": "pnpm --filter @covet/db generate",
    "db:migrate": "pnpm --filter @covet/db migrate",
    "db:studio": "pnpm --filter @covet/db studio",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1"
}
